# Copie para .env.prod e preencha. NUNCA versione o .env.prod.
# Gere segredos com:  openssl rand -hex 32

# Domínio público. Sem domínio próprio, use o IP com traços + sslip.io:
#   ex.: VM 136.248.115.136  ->  136-248-115-136.sslip.io
DOMAIN=SEU-IP-COM-TRACOS.sslip.io

# Django
SECRET_KEY=TROQUE-openssl-rand-hex-32
ADMIN_URL=painel-interno-TROQUE
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7
# App mobile/Expo web em outra origem? liste aqui (separado por vírgula).
CORS_ALLOWED_ORIGINS=

# Admin inicial (criado só se ainda não houver ADM ativo). Senha forte!
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres (rede interna do Docker, nunca exposto)
POSTGRES_DB=toca_espanhol
POSTGRES_USER=toca
POSTGRES_PASSWORD=TROQUE-openssl-rand-hex-32

BACKUP_KEEP_DAYS=7
BACKEND_MEM_LIMIT=768m
