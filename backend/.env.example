# Copie para .env e ajuste. No Render estas variáveis são definidas no dashboard
# (exceto DATABASE_URL, que o Blueprint conecta automaticamente ao banco).

SECRET_KEY=troque-esta-chave
DEBUG=True
# Pra testar pelo app mobile (Expo) num celular físico, acrescente o IP da
# sua máquina na rede local — ex.: rode "hostname -I" e adicione o resultado.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.0.101

# Local: aponte para o seu Postgres. No Render: injetado automaticamente.
DATABASE_URL=postgres://tocauser:toca123@localhost:5432/toca_espanhol

# Origens do frontend permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7
